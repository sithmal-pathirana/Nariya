{
  "name": "nariya-tests",
  "private": true,
  "type": "module",
  "description": "Unit and end-to-end tests for the Nariya extension",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"unit/*.test.mjs\" \"e2e/*.test.mjs\"",
    "test:unit": "node --test \"unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/*.test.mjs\"",
    "lint": "cd .. && tests/node_modules/.bin/eslint .",
    "package": "node ../tools/package.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "eslint": "10.1.0"
  }
}
